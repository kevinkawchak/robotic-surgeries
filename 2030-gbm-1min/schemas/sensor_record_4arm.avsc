    {"name": "estop_state", "type": ["null", "int"], "default": null},
    {"name": "safety_zone", "type": ["null", {"type": "enum", "name": "SafetyZone", "symbols": ["NONE", "OUTER", "INNER", "ELOQUENT", "FORBIDDEN", "TUMOR_CORE", "TUMOR_MARGIN", "VESSEL"]}], "default": null},
    {"name": "robot_state", "type": ["null", {"type": "enum", "name": "RobotState", "symbols": ["IDLE", "SETUP", "DOCKED", "READY", "ACTIVE", "PAUSE", "COMPLETE", "ABORT"]}], "default": null},
    {"name": "heartbeat_ok", "type": ["null", "int"], "default": null},
    {"name": "tick_align_flag", "type": ["null", "int"], "default": null}
