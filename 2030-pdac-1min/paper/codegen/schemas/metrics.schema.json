{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metrics.schema.json",
  "title": "PDAC 1 minute per iteration composite score record",
  "description": "6 component composite score record produced by src/metrics/compute_1min.py.",
  "type": "object",
  "required": [
    "iteration_id", "seed", "composite_score", "quality", "time", "cost",
    "safety", "patient_experience", "anastomosis_quality"
  ],
  "properties": {
    "iteration_id": {"type": "integer", "minimum": 0, "maximum": 31},
    "seed": {"type": "integer"},
    "composite_score": {"type": "number", "minimum": 0, "maximum": 100},
    "quality": {"type": "number", "minimum": 0, "maximum": 100},
    "time": {"type": "number", "minimum": 0, "maximum": 100},
    "cost": {"type": "number", "minimum": 0, "maximum": 100},
    "safety": {"type": "number", "minimum": 0, "maximum": 100},
    "patient_experience": {"type": "number", "minimum": 0, "maximum": 100},
    "anastomosis_quality": {"type": "number", "minimum": 0, "maximum": 100},
    "realized_frs": {"type": "number", "minimum": 0, "maximum": 10},
    "realized_pj_grade": {"type": "string", "enum": ["A", "B", "C"]},
    "realized_hj_leak": {"type": "string", "enum": ["absent", "present"]},
    "realized_gj_patency": {"type": "string", "enum": ["patent", "delayed"]},
    "weights": {
      "type": "object",
      "properties": {
        "quality": {"const": 0.30},
        "time": {"const": 0.20},
        "cost": {"const": 0.15},
        "safety": {"const": 0.15},
        "patient_experience": {"const": 0.05},
        "anastomosis_quality": {"const": 0.15}
      }
    }
  }
}
