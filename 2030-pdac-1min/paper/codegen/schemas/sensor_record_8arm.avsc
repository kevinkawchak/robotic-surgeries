{
  "type": "record",
  "name": "SensorRecord8Arm",
  "namespace": "pdac_1min.v0_6_0",
  "doc": "PDAC 1 minute 8 arm sensor record at mixed 100 kHz force plus 10 kHz command rates.",
  "fields": [
    {"name": "tick", "type": "long"},
    {"name": "arm_id", "type": "int"},
    {"name": "phase", "type": "int"},
    {"name": "q", "type": {"type": "array", "items": "double"}},
    {"name": "qd", "type": {"type": "array", "items": "double"}},
    {"name": "tau", "type": {"type": "array", "items": "double"}},
    {"name": "ee_pos", "type": {"type": "array", "items": "double"}},
    {"name": "ee_quat", "type": {"type": "array", "items": "double"}},
    {"name": "ee_vel", "type": {"type": "array", "items": "double"}},
    {"name": "ee_force", "type": {"type": "array", "items": "double"}},
    {"name": "ee_torque", "type": {"type": "array", "items": "double"}},
    {"name": "tool_state", "type": {"type": "enum", "name": "ToolState", "symbols": ["idle", "approach", "engage", "coag", "cut", "suction", "suture", "withdraw"]}},
    {"name": "tool_subtype", "type": "int"},
    {"name": "bipolar_current", "type": "double"},
    {"name": "bipolar_voltage", "type": "double"},
    {"name": "suction_pressure", "type": "double"},
    {"name": "suction_flow", "type": "double"},
    {"name": "irrigation_flow", "type": "double"},
    {"name": "vessel_proximity", "type": "double"},
    {"name": "nir_icg", "type": {"type": "array", "items": "double"}},
    {"name": "duct_manometry", "type": "double"},
    {"name": "ring_tension", "type": "double"},
    {"name": "bile_spectrophotometry", "type": {"type": "array", "items": "double"}},
    {"name": "us_b_mode", "type": {"type": "array", "items": "double"}},
    {"name": "heartbeat_seq", "type": "long"},
    {"name": "heartbeat_watchdog", "type": "int"},
    {"name": "tip_force_scalar", "type": "double"},
    {"name": "cumulative_cross_arm_force", "type": "double"},
    {"name": "force_time_integral", "type": "double"},
    {"name": "engagement_depth", "type": "double"},
    {"name": "estop_state", "type": {"type": "enum", "name": "EStopState", "symbols": ["idle", "armed", "triggered", "parked"]}},
    {"name": "temperature", "type": "double"},
    {"name": "power", "type": "double"},
    {"name": "collision_state", "type": {"type": "enum", "name": "CollisionState", "symbols": ["clear", "proximity", "contact", "unsafe"]}},
    {"name": "tool_changer_state", "type": "int"},
    {"name": "task_id", "type": "long"},
    {"name": "phase_id", "type": "int"},
    {"name": "queue_depth", "type": "int"}
  ]
}
